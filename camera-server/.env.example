# Copy to .env (the server creates .env for you on first run and fills in VIEWER_TOKEN).

# Network
HOST=0.0.0.0
PORT=8443
# 1 = serve HTTPS with a self-signed certificate (required for the phone camera).
# 0 = plain HTTP, only for use behind a tunnel/reverse proxy that already does HTTPS.
TLS=1
# Extra hostnames/IPs to put in the certificate, comma separated (optional)
EXTRA_SANS=

# Which web pages may connect to the viewer socket (your HighLo URLs), comma separated
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Secrets. VIEWER_TOKEN is what you paste into HighLo's "Camera" settings.
# Leave PHONE_TOKEN empty to get a fresh one every time the server starts.
VIEWER_TOKEN=
PHONE_TOKEN=

# Detection (YOLO). If the model file is missing the server just streams video.
MODEL_PATH=models/cards.pt
CONF=0.5
IMGSZ=1280
# "" = automatic, "cpu", "0" (first GPU), "mps" (Apple silicon)
DEVICE=

# Largest single video frame accepted from the phone, in bytes
MAX_FRAME_BYTES=2000000
